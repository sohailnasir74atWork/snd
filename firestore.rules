rules_version = '2';

// SnD Manager — Firestore Security Rules (SRS §10.2, rules slices 1–2).
// Identity rides in the token: request.auth.token.companyId / .role are set
// by the admitSignIn Cloud Function (§4.3, §10.1). Default is DENY.
//
// Later slices (delivery field-whitelists, visibility toggles inside rules,
// counters transaction shape) tighten this further per the Plan §6 schedule;
// every change re-runs the emulator suite before the pilot.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function claims() { return request.auth.token; }
    function inCompany(companyId) {
      return signedIn() && claims().companyId == companyId;
    }
    function isAdmin(companyId) {
      return inCompany(companyId) && claims().role == 'admin';
    }
    function isBooker(companyId) {
      return inCompany(companyId) && claims().role == 'booker';
    }
    function isRider(companyId) {
      return inCompany(companyId) && claims().role == 'rider';
    }

    // ---- employeeDirectory: the door. Clients never touch it. -------------
    // Only the Cloud Functions (Admin SDK bypasses rules) read or write here;
    // the Owner manages it through addEmployee/removeEmployee callables.
    match /employeeDirectory/{email} {
      allow read, write: if false;
    }

    // ---- company workspaces ----------------------------------------------
    match /companies/{companyId} {
      // The workspace document itself: readable by its members.
      allow read: if inCompany(companyId);
      allow write: if false; // created by admitSignIn only

      match /users/{uid} {
        allow read: if inCompany(companyId);
        allow update: if isAdmin(companyId)
                      || (signedIn() && request.auth.uid == uid
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['name', 'photoUrl', 'fcmToken', 'lastSyncAt']));
        allow create, delete: if false; // admitSignIn / removeEmployee only
      }

      match /settings/{docId} {
        allow read: if inCompany(companyId);
        allow write: if isAdmin(companyId);
      }

      // One day document per person PER DATE — the id is "{uid}_{YYYY-MM-DD}",
      // and ownership is proven by the staffId FIELD rather than the id, so the
      // id shape can change without reopening the rules.
      //
      // Why per-date: a single reused document carried yesterday's
      // handoverConfirmed into today. The staff phone then showed "confirmed"
      // before the owner had counted a rupee, the owner's confirm card never
      // appeared, and — because a rider's [Start route] rewrites the whole day
      // — his morning write became an UPDATE that flipped handoverConfirmed
      // back to false, which this rule (correctly) refuses. He could never
      // start a route again. A fresh document each morning is a CREATE, so
      // none of that can happen (FR-6.2, FR-7.9, FR-7.11).
      match /days/{dayId} {
        allow read: if inCompany(companyId);
        // His own fresh day: allowed, but never already-confirmed.
        allow create: if isAdmin(companyId)
                      || (request.resource.data.staffId == request.auth.uid
                          && request.resource.data.get('handoverConfirmed', false) == false);
        // Updating his own day: he may start his route and hand over; only an
        // admin may ever touch handoverConfirmed (FR-7.11).
        allow update: if isAdmin(companyId)
                      || (resource.data.staffId == request.auth.uid
                          && !request.resource.data.diff(resource.data)
                                .affectedKeys().hasAny(['handoverConfirmed']));
        allow delete: if false;
      }

      // Mirror of the server-side directory for the Employees screen (display only;
      // the real door is the top-level employeeDirectory, server-only).
      match /employeeList/{email} {
        allow read, write: if isAdmin(companyId);
      }

      // The round list. Everyone reads it — it is what every shop form picks
      // from — and only the owner writes it, which is the whole point of
      // taking area creation out of the shop form.
      match /areas/{areaId} {
        allow read: if inCompany(companyId);
        allow write: if isAdmin(companyId);
      }

      match /shops/{shopId} {
        allow read: if inCompany(companyId);
        allow create: if isAdmin(companyId) || isBooker(companyId);
        // A booker may keep shop details and flag a collection — but he can
        // never move the balance; that is what payments are for (FR-7.10).
        allow update: if isAdmin(companyId)
                      || (isBooker(companyId)
                          && !request.resource.data.diff(resource.data)
                                .affectedKeys().hasAny(['outstanding']))
                              // rider may only clear/set collection flags in transactions
                              || (isRider(companyId)
                                  && request.resource.data.diff(resource.data)
                                       .affectedKeys().hasOnly(['collectionFlagged', 'collectionFlaggedAt',
                                                                'collectionFlaggedBy',
                                                                'outstanding', 'oldestUnpaidAt', 'oldestUnpaidAmount',
                                                                'lastShelfCount', 'lastShelfCountAt']))
                              // The rider is at more shop doors in a day than
                              // anyone, so the rider is how the map gets filled
                              // in. A SEPARATE hasOnly rather than two more
                              // names on the list above: keeping the clauses
                              // apart is what stops a pin write from also
                              // carrying a balance key.
                              || (isRider(companyId)
                                  && request.resource.data.diff(resource.data)
                                       .affectedKeys().hasOnly(['location', 'photoUrl']));
        allow delete: if false; // deactivate, never delete
      }

      match /products/{productId} {
        allow read: if inCompany(companyId);
        // costPrice must NEVER live on a product doc: every staff phone syncs
        // this collection, and margins are owner-only (FR-15.1). Costs live in
        // productCosts below. The admin check is on the FINAL doc, so the
        // client's one-time migration (which deletes the field) still passes.
        allow write: if (isAdmin(companyId)
                         && !('costPrice' in request.resource.data))
                     // stock/committed move inside delivery transactions
                     || (isRider(companyId)
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['stockQty', 'committedQty']))
                     || (isBooker(companyId)
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['committedQty']));
      }

      match /orders/{orderId} {
        allow read: if isAdmin(companyId)
                    || (isBooker(companyId) && resource.data.bookedBy == request.auth.uid)
                    || (isRider(companyId) && resource.data.assignedTo == request.auth.uid);
        allow create: if isAdmin(companyId) || isBooker(companyId);
        allow update: if isAdmin(companyId)
                      || (isBooker(companyId)
                          && resource.data.bookedBy == request.auth.uid
                          && resource.data.status in ['booked', 'assigned'])
                      || (isRider(companyId)
                          && resource.data.assignedTo == request.auth.uid
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['items', 'billedTotals', 'invoiceNo', 'invoiceProvisional',
                                                        'invoicedAt', 'status', 'paymentStatus', 'amountPaid',
                                                        'balance', 'deliveredAt', 'proofPhotoUrl',
                                                        'undeliveredReason', 'deliveryDate', 'deliveryDay',
                                                        'seenAt', 'updatedAt']));
        allow delete: if false; // cancel, never delete (FR-5.7)
      }

      // ---- payments: THE two lines that carry the money model --------------
      // Booker create is legal ONLY with the exception flag (FR-7.13/FR-7.10).
      match /payments/{paymentId} {
        allow read: if isAdmin(companyId)
                    || (signedIn() && resource.data.collectedBy == request.auth.uid);
        // A new payment is ALWAYS unconfirmed, always attributed to the person
        // making it, always positive. Without these three lines a modified app
        // could mint already-confirmed cash in someone else's name (FR-7.11).
        allow create: if request.resource.data.confirmed == false
                      && request.resource.data.collectedBy == request.auth.uid
                      && request.resource.data.amount is int
                      && request.resource.data.amount > 0
                      && (isAdmin(companyId)
                          || isRider(companyId)
                          || (isBooker(companyId) && request.resource.data.exception == true));
        // Append-only (FR-7.6) with two owner-only exceptions: confirming the
        // handover (FR-7.11) and VOIDING a wrong entry — the row stays visible
        // forever, only the flag flips (a rider typo must be correctable
        // without ever deleting money history).
        // `orderIds` rides along because a booker's exception payment is
        // allocated across bills only at confirmation time — without persisting
        // that split, voiding it later could not un-apply it (FR-7.13).
        allow update: if isAdmin(companyId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['confirmed', 'voided', 'voidedBy', 'voidedAt', 'orderIds']);
        allow delete: if false;
      }

      // Handover confirm is admin-only — the ONLY path to "confirmed" cash (FR-7.11).
      match /handovers/{handoverId} {
        allow read: if inCompany(companyId);
        allow create: if inCompany(companyId)
                      && request.resource.data.staffId == request.auth.uid;
        allow update: if isAdmin(companyId); // writes countedByMode/confirmedAt/discrepancy
        allow delete: if false;
      }

      match /floatMovements/{id} {
        allow read: if isAdmin(companyId)
                    || (signedIn() && resource.data.staffId == request.auth.uid);
        allow create: if isAdmin(companyId); // issue/return; payout rows via reward txn
        allow update, delete: if false;
      }

      match /stockMovements/{id} {
        allow read: if isAdmin(companyId);
        allow create: if isAdmin(companyId) || isRider(companyId);
        allow update, delete: if false;
      }

      // Serial counters may only ever go UP, one at a time. Without this any
      // staff phone could reset them and re-issue duplicate bill numbers (§8.1).
      match /counters/{year} {
        allow read: if inCompany(companyId);
        allow create: if inCompany(companyId);
        allow update: if inCompany(companyId)
                      && request.resource.data.keys().hasOnly(['order', 'invoice', 'receipt', 'reward'])
                      && (!('order' in request.resource.data) || !('order' in resource.data)
                          || request.resource.data.order == resource.data.order + 1
                          || request.resource.data.order == resource.data.order)
                      && (!('invoice' in request.resource.data) || !('invoice' in resource.data)
                          || request.resource.data.invoice == resource.data.invoice + 1
                          || request.resource.data.invoice == resource.data.invoice)
                      && (!('receipt' in request.resource.data) || !('receipt' in resource.data)
                          || request.resource.data.receipt == resource.data.receipt + 1
                          || request.resource.data.receipt == resource.data.receipt)
                      && (!('reward' in request.resource.data) || !('reward' in resource.data)
                          || request.resource.data.reward == resource.data.reward + 1
                          || request.resource.data.reward == resource.data.reward);
        allow delete: if false;
      }

      // ---- owner-only money: hard deny for staff (FR-15.1, FR-17.4) --------
      match /productCosts/{id}  { allow read, write: if isAdmin(companyId); }
      match /orderProfit/{id}   { allow read: if isAdmin(companyId); allow write: if false; } // Cloud Function writes
      match /fixedCharges/{id}  { allow read, write: if isAdmin(companyId); }
      match /expenses/{id}      { allow read, write: if isAdmin(companyId); }

      match /visits/{id} {
        allow read: if isAdmin(companyId)
                    || (isBooker(companyId) && resource.data.by == request.auth.uid);
        allow create: if isBooker(companyId) || isAdmin(companyId);
        allow update, delete: if false;
      }

      match /rewardStaff/{id} {
        allow read: if isAdmin(companyId) || isBooker(companyId);
        allow create, update: if isAdmin(companyId) || isBooker(companyId);
        allow delete: if false;
      }

      match /rewardClaims/{id} {
        allow read: if isAdmin(companyId)
                    || (isBooker(companyId) && resource.data.by == request.auth.uid);
        allow create: if isBooker(companyId) || isAdmin(companyId);
        // Approval fields are admin-only; the booker can never approve himself (FR-16.5).
        allow update: if isAdmin(companyId);
        allow delete: if false;
      }

      match /assignments/{id} {
        allow read: if isAdmin(companyId) || isRider(companyId);
        allow write: if isAdmin(companyId);
      }

      match /targets/{id} {
        allow read: if isAdmin(companyId)
                    || (isBooker(companyId) && id.matches(request.auth.uid + '_.*'));
        allow write: if isAdmin(companyId);
      }
    }
  }
}
